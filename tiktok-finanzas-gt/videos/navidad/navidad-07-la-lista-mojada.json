          "accion": "quieto",
          "tam": 0.8
        }
      ]
    },
    {
      "texto": "La nueva lista quedó perfecta. Y todo, gracias a que Canela había hecho su trabajo con mucho cuidado.",
      "escenario": "taller",
      "elementos": [
        {
