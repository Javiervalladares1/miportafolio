          "pos": "der",
          "accion": "salta"
        }
      ]
    },
    {
      "texto": "Su mamá había encontrado un lugar calientito, protegido del viento, para cuidarlos.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "🐦",
          "pos": "arriba-centro",
