        }
      ]
    },
    {
      "texto": "Decía: Querido Santa, soy un ratoncito. Vivo con mi familia debajo de un árbol. Este invierno es muy frío. ¿Podrías traernos una cobijita? Gracias.",
      "escenario": "bosque",
      "elementos": [
        {
          "p": "raton",
          "pos": "izq",
          "accion": "tiembla"
        },
        {
          "p": "raton",
