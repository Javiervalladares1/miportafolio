          "accion": "brilla",
          "tam": 0.4
        }
      ]
    },
    {
      "texto": "¡No puedo leerla!, dijo Canela. Pino trajo su lupa más grande, y juntos leyeron las letras diminutas.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "canela",
