          "pos": "der",
          "accion": "tiembla",
          "tam": 0.8
        }
      ]
    },
    {
      "texto": "Pino se rió: Una cobija para ratones es muy fácil. ¡Es pequeñísima! Pero Canela le dijo: Pequeña, pero muy importante.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "pino",
          "pos": "izq",
          "accion": "gira"
        },
        {
          "p": "canela",
          "pos": "der"
        }
      ]
    },
    {
      "texto": "Canela buscó la lana más suave del taller, y tejió una cobija roja, con un botoncito dorado.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "canela",
          "pos": "izq"
        },
        {
          "p": "🧶",
          "pos": "medio-centro",
          "accion": "gira"
        },
