          "accion": "brilla",
          "tam": 0.8
        }
      ]
    },
    {
      "texto": "Botón se puso triste. Entonces, ¿yo nunca voy a tener nada especial?",
      "escenario": "noche",
      "elementos": [
        {
          "p": "boton",
          "pos": "centro",
          "accion": "tiembla"
        }
      ]
    },
    {
      "texto": "¡Claro que sí!, dijo la Luna. Mira a tu alrededor: tú puedes ver las estrellas, la nieve que brilla, y las luces de colores en el cielo.",
      "escenario": "noche",
      "elementos": [
        {
          "p": "boton",
          "pos": "izq"
        },
        {
          "p": "luna",
          "pos": "arriba-der",
