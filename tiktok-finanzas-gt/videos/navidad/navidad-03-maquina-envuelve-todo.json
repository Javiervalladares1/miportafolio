  "escenas": [
    {
      "texto": "¡Jo, jo, jo! Hola, pequeños. En mi taller hay que envolver miles de regalos, y eso toma mucho, mucho tiempo.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "santa",
