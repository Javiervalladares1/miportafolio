          "pos": "der",
          "accion": "entra"
        }
      ]
    },
    {
      "texto": "Entonces Canela y Pino se sentaron juntos e hicieron un plan, paso por paso, antes de volver a encenderla.",
      "escenario": "taller",
      "elementos": [
        {
          "p": "pino",
